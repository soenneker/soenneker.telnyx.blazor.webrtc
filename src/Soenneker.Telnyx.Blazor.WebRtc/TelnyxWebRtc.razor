@using Soenneker.Telnyx.Blazor.WebRtc.Abstract
@using Soenneker.Telnyx.Blazor.WebRtc.Enums
@inherits Soenneker.Lepton.Suite.LeptonCancellableIdentifiableContentElement
@implements ITelnyxWebRtc

<div @attributes="EffectiveAttributes">
    @if (EffectiveMediaMode == TelnyxMediaMode.Video)
    {
        <video id="@_localElementId" autoplay playsinline muted></video>
        <video id="@_remoteElementId" autoplay playsinline></video>
    }
    else if (EffectiveMediaMode == TelnyxMediaMode.Audio)
    {
        <audio id="@_remoteElementId" autoplay playsinline style="display:none"></audio>
    }
    @ChildContent
</div>
